{
  "name": "@promethean-os/logger",
  "version": "0.1.0",
  "description": "Structured logging package for Promethean with Winston",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --out-dir dist --tsconfig tsconfig.json && tsc -p tsconfig.json --emitDeclarationOnly --declaration",
    "test": "ava",
    "test:unit": "ava src/tests/**/*.test.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "dev": "tsc --watch"
  },
  "keywords": [
    "logging",
    "winston",
    "structured",
    "promethean"
  ],
  "author": "Promethean Team",
  "license": "GPL-3.0-only",
  "dependencies": {
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "ava": "^6.0.0",
    "typescript": "^5.2.0",
    "tsup": "^8.5.1"
  },
  "ava": {
    "extensions": {
      "ts": "module"
    },
    "nodeArguments": [
      "--loader=ts-node/esm"
    ]
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./dist/*": "./dist/*",
    "./*": "./dist/*"
  }
}
